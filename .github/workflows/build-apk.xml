name: Build MGI Movement APK

on:
  workflow_dispatch:
  push:
    branches: [ main, master ]

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'
          cache: gradle

      - name: Set up Android SDK
        uses: android-actions/setup-android@v3

      - name: Install Android SDK 35
        run: sdkmanager "platform-tools" "platforms;android-35" "build-tools;35.0.0"

      - name: Create Android project files
        shell: bash
        run: |
          set -e
          mkdir -p "$(dirname "app/build.gradle")"
          printf '%s' "" | base64 -d > "app/build.gradle"
          mkdir -p "$(dirname "app/src/main/AndroidManifest.xml")"
          printf '%s' "" | base64 -d > "app/src/main/AndroidManifest.xml"
          mkdir -p "$(dirname "app/src/main/assets/movement_data.json")"
          printf '%s' "" | base64 -d > "app/src/main/assets/movement_data.json"
          mkdir -p "$(dirname "app/src/main/java/com/mgi/movement/MainActivity.java")"
          printf '%s' "" | base64 -d > "app/src/main/java/com/mgi/movement/MainActivity.java"
          mkdir -p "$(dirname "app/src/main/res/values/strings.xml")"
          printf '%s' "PHJlc291cmNlcz48c3RyaW5nIG5hbWU9ImFwcF9uYW1lIj5NR0kgTW92ZW1lbnQgUmVnaXN0ZXI8L3N0cmluZz48L3Jlc291cmNlcz4K" | base64 -d > "app/src/main/res/values/strings.xml"
          mkdir -p "$(dirname "app/src/main/res/values/styles.xml")"
          printf '%s' "" | base64 -d > "app/src/main/res/values/styles.xml"
          mkdir -p "$(dirname "build.gradle")"
          printf '%s' "cGx1Z2lucyB7CiAgICBpZCAnY29tLmFuZHJvaWQuYXBwbGljYXRpb24nIHZlcnNpb24gJzguNi4xJyBhcHBseSBmYWxzZQp9Cg==" | base64 -d > "build.gradle"
          mkdir -p "$(dirname "gradle.properties")"
          printf '%s' "b3JnLmdyYWRsZS5qdm1hcmdzPS1YbXgyMDQ4bSAtRGZpbGUuZW5jb2Rpbmc9VVRGLTgKYW5kcm9pZC51c2VBbmRyb2lkWD1mYWxzZQphbmRyb2lkLm5vblRyYW5zaXRpdmVSQ2xhc3M9dHJ1ZQo=" | base64 -d > "gradle.properties"
          mkdir -p "$(dirname "settings.gradle")"
          printf '%s' "" | base64 -d > "settings.gradle"

      - name: Set up Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.10.2'

      - name: Build debug APK
        run: gradle --no-daemon :app:assembleDebug

      - name: Verify APK
        run: |
          test -f app/build/outputs/apk/debug/app-debug.apk
          ls -lh app/build/outputs/apk/debug/app-debug.apk

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: MGI-Movement-debug-APK
          path: app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error
